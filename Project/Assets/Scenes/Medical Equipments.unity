  m_Script: {fileID: 11500000, guid: efb8d1c86ece5744ea6af09575454f7e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ShowMessagesController
  messageOutput: {fileID: 464386849}
  messages:
  - Press the NEXT button  to start the simulation.
  - "An MRI device is a medical scanner that uses strong magnets and radio waves
    to create detailed images of the inside of your body. It\u2019s especially good
    for showing soft tissues like the brain, muscles, and organs\u2014without using
    any radiation."
  - Now press the ON button to turn the device ON.
  - Please wait until the device turns ON
  - The device is now available for use. Press NEXT to call a patient
  - Please wait until the patient lies on the MRI bed
  - The patient is ready to be examined. Press UP ARROW button to move the bed inside
    MRI
  - Please wait until the bed moves inside MRI
  - Press SCAN button to start the scan
  - Please wait until MRI finishes scanning the patient
  - The scan completed. Press DOWN ARROW button to move the bed out so the patient
    can come out
  - Please wait until the bed outside of MRI
  - Press OFF button to turn the MRI device OFF
  - Please wait until the device turns OFF
  - Device is OFF
